DATABASE_URL=postgresql://localhost:5432/iphonebooking_v2?schema=public
PORT=4000
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
SEED_DEVELOPMENT=true
# Set locally before running db:seed; never deploy with a shared default password.
ADMIN_EMAIL=admin@iphonebooking.local
ADMIN_PASSWORD=
# Canonical public origin; use HTTPS in staging and production.
PUBLIC_ORIGIN=http://localhost:5173
# Optional separate admin origin. Each browser origin must proxy /api to this service.
ADMIN_ORIGIN=
HOST=127.0.0.1
# Set only to the exact count of trusted reverse proxies in deployment.
TRUST_PROXY_HOPS=
# Integration tests refuse to use a database without _test in its URL.
TEST_DATABASE_URL=postgresql://localhost:5432/iphonebooking_v2_test?schema=public
# Require QC to be performed by someone other than the receiving/repair technician.
REQUIRE_INDEPENDENT_REPAIR_QC=false
REQUIRE_INDEPENDENT_RECEIVING_QC=false
# Disabled until all provider fields are supplied. Never use VITE_ for secrets.
MAIL_PROVIDER=unconfigured
RESEND_API_KEY=
MAIL_FROM=
AUTH_EMAIL_SECRET=
# Use sandbox first; leave both blank to keep online checkout disabled.
KHALTI_ENVIRONMENT=
KHALTI_SECRET_KEY=
