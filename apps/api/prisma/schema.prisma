}

// ── SECTION 188: What-If Planning ─────────────────────────────────
model Simulation {
  id        String   @id @default(cuid())
  name      String
  scenario  Json
  results   Json?
  createdAt DateTime @default(now())
}

// ── SECTION 189: Status & Incident System ─────────────────────────
model ServiceStatus {
  id         String    @id @default(cuid())
  service    String    @unique
  status     String    @default("OPERATIONAL")
  degradedAt DateTime?
  resolvedAt DateTime?
  message    String?
  createdAt  DateTime  @default(now())
}

model Incident {
  id          String    @id @default(cuid())
  severity    String
  title       String
  description String?
  status      String    @default("DETECTED")
  service     String?
  startedAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

// ── SECTION 192: Migration Safety ─────────────────────────────────
model MigrationRun {
  id           String    @id @default(cuid())
  version      String
  name         String
  direction    String
  durationMs   Int?
  rowsAffected Int?
  checksum     String?
  status       String    @default("PENDING")
  executedAt   DateTime?
  rollbackPlan Json?
}

// ── Section 154: Warranty Entitlement Engine ──────────────────────
model WarrantyEntitlement {
  id           String   @id @default(cuid())
  deviceId     String?
  orderId      String?
  type         String
  startDate    DateTime
  expiryDate   DateTime
  terms        Json?
  status       String   @default("ACTIVE")
  claimHistory Json[]
}

// ── Section 143: Loyalty Ledger ────────────────────────────────────
model LoyaltyLedgerEntry {
  id         String    @id @default(cuid())
  customerId String
  action     String
  amount     Int
  balance    Int
  expiryDate DateTime?
  reference  String?
  reason     String?
  createdAt  DateTime  @default(now())
}

// ── Section 144: Referral Engine ──────────────────────────────────
model Referral {
  id              String    @id @default(cuid())
  referrerId      String
  refereeId       String
  campaign        String?
  qualifyingEvent String?
  rewardAmount    Int?
  rewardStatus    String    @default("PENDING")
  fraudFlags      Json[]
  reversedAt      DateTime?
  createdAt       DateTime  @default(now())
}

// ── Section 136: Accessory Fit Guarantee ──────────────────────────
model AccessoryFitCheck {
  id          String   @id @default(cuid())
  customerId  String
  accessoryId String
  deviceId    String?
  compatible  Boolean
  warning     String?
  checkedAt   DateTime @default(now())
}

model PartMovement {
  id        String   @id @default(cuid())
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Restrict)
  repairId  String?
  repair    Repair?  @relation(fields: [repairId], references: [id], onDelete: Restrict)
  type      String
  quantity  Int
  unitCost  Int
  reference String   @unique
  actorId   String
  createdAt DateTime @default(now())

  @@index([partId, createdAt])
}

model OrderMoneyEntry {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  kind      String
  amount    Int
  currency  String   @default("NPR")
  eventKey  String   @unique
  source    String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}
