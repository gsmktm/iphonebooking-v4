generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[]
  users       User[]
}

model User {
  shopRevision          Int                @default(0)
  id                    String             @id @default(cuid())
  email                 String             @unique
  name                  String
  passwordHash          String
  status                AccountStatus      @default(ACTIVE)
  emailVerifiedAt       DateTime?
  passwordChangedAt     DateTime?
  roleId                String?
  role                  Role?              @relation(fields: [roleId], references: [id])
  createdAt             DateTime           @default(now())
  sessions              UserSession[]
  accountTokens         AccountToken[]
  addresses             Address[]
  orders                Order[]
  devices               Device[]
  repairs               Repair[]
  assignedRepairs       Repair[]           @relation("AssignedTechnician")
  technicianAssignments RepairAssignment[] @relation("RepairTechnician")
  repairAssignmentsMade RepairAssignment[] @relation("RepairAssigner")
  tradeIns              TradeIn[]
  tickets               SupportTicket[]
  notifications         Notification[]
  wishlist              Wishlist[]
  cart                  CartItem[]
  appointments          Appointment[]
  retailerMemberships   RetailerMember[]
  retailerApplication   RetailerApplication?
  reviews               Review[]
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AccountTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model AccountToken {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     AccountTokenPurpose
  tokenHash   String              @unique
  requestKey  String              @unique
  email       String
  expiresAt   DateTime
  consumedAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime            @default(now())

  @@index([userId, purpose, expiresAt])
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  label        String
  province     String
  district     String
  municipality String
  ward         String
  area         String
  landmark     String?
  phone        String
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  image       String
  products    Product[]
}

/// Read-only editorial references, verified against Apple.com.
/// Never mix these records with merchant stock, prices, bookings, or orders.
model AppleReferenceModel {
  id              String   @id
  category        String
  name            String
  summary         String
  officialUrl     String
  sourceCheckedAt DateTime
  sortOrder       Int      @default(0)
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([category, sortOrder])
}

model Product {
  id                  String                   @id @default(cuid())
  slug                String                   @unique
  name                String
  tagline             String
  description         String
  categoryId          String
  category            Category                 @relation(fields: [categoryId], references: [id])
  image               String
  gallery             String[]
  specs               Json
  badge               String?
  active              Boolean                  @default(true)
  featured            Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  variants            ProductVariant[]
  wishlist            Wishlist[]
  compatibleWith      AccessoryCompatibility[] @relation("Accessory")
  accessories         AccessoryCompatibility[] @relation("CompatibleDevice")
  deviceIdentities    DeviceIdentity[]
  partCompatibilities PartCompatibility[]
  reviews             Review[]
}

model ProductVariant {
  id               String           @id @default(cuid())
  productId        String
  product          Product          @relation(fields: [productId], references: [id])
  sku              String           @unique
  color            String
  colorHex         String
  storage          String
  region           String           @default("International")
  price            Int
  comparePrice     Int?
  deposit          Int
  image            String?
  preorder         Boolean          @default(false)
  stock            InventoryStock[]
  units            InventoryUnit[]
  orderItems       OrderItem[]
  cart             CartItem[]
  deviceIdentities DeviceIdentity[]
}

model AccessoryCompatibility {
  accessoryId String
  deviceId    String
  accessory   Product @relation("Accessory", fields: [accessoryId], references: [id])
  device      Product @relation("CompatibleDevice", fields: [deviceId], references: [id])

  @@id([accessoryId, deviceId])
}

model Store {
  id       String           @id @default(cuid())
  slug     String           @unique
  name     String
  address  String
  hours    String
  phone    String
  services String[]
  stocks   InventoryStock[]
  retailerId         String?
  retailer           Retailer? @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  retailerAssignedAt DateTime?

  @@index([retailerId])
}

model InventoryStock {
  id        String            @id @default(cuid())
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id])
  storeId   String
  store     Store             @relation(fields: [storeId], references: [id])
  available Int               @default(0)
  reserved  Int               @default(0)
  ledger    InventoryLedger[]
  units     InventoryUnit[]

  @@unique([variantId, storeId])
}

model InventoryLedger {
  id        String         @id @default(cuid())
  stockId   String
  stock     InventoryStock @relation(fields: [stockId], references: [id])
  type      String
  quantity  Int
  reference String
  createdAt DateTime       @default(now())
}

model InventoryUnit {
  grnId       String?
  grn         GoodsReceivedNote? @relation(fields: [grnId], references: [id], onDelete: Restrict)
  cost        Int?
  stockId     String?
  stock       InventoryStock?    @relation(fields: [stockId], references: [id])
  identity    DeviceIdentity?
  id          String             @id @default(cuid())
  variantId   String
  variant     ProductVariant     @relation(fields: [variantId], references: [id])
  serialHash  String             @unique
  serialLast4 String
  status      String             @default("AVAILABLE")
  device      Device?
  allocation  BookingAllocation?
}

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([userId, variantId])
}

model Wishlist {
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@id([userId, productId])
}

model Order {
  moneyEntries     OrderMoneyEntry[]
  id               String               @id @default(cuid())
  number           String               @unique
  userId           String?
  user             User?                @relation(fields: [userId], references: [id])
  email            String
  name             String
  phone            String
  address          Json
  fulfillment      String
  status           String               @default("PLACED")
  total            Int
  dueNow           Int
  currency         String               @default("NPR")
  trackingHash     String               @unique
  idempotencyKey   String               @unique
  requestHash      String?
  expiresAt        DateTime
  createdAt        DateTime             @default(now())
  items            OrderItem[]
  history          OrderStatusHistory[]
  booking          Booking?
  payments         Payment[]
  devices          Device[]
  tradeInId        String?              @unique
  tradeIn          TradeIn?             @relation(fields: [tradeInId], references: [id])
  allocations      BookingAllocation[]
  policyAcceptance PolicyAcceptance?
  organization     Organization?        @relation(fields: [organizationId], references: [id])
  organizationId   String?

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Int
  stockId   String
  review    Review?
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Review {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItemId String       @unique
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  rating      Int
  title       String
  body        String
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  status    String
  note      String
  createdAt DateTime @default(now())
}

model Booking {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  status     String   @default("PENDING_PAYMENT")
  preference String?
  createdAt  DateTime @default(now())
}

model Payment {
  moneyEntries OrderMoneyEntry[]
  id           String            @id @default(cuid())
  orderId      String
  order        Order             @relation(fields: [orderId], references: [id])
  provider     String
  externalId   String?           @unique
  transactionId String?          @unique
  idempotencyKey String?          @unique
  currency     String            @default("NPR")
  checkoutUrl  String?
  expiresAt    DateTime?
  verifiedAt   DateTime?
  failureCode  String?
  amount       Int
  status       String            @default("PENDING")
  createdAt    DateTime          @default(now())
  refunds      Refund[]
}

model Refund {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  amount    Int
  status    String   @default("REQUESTED")
  reason    String
  createdAt DateTime @default(now())
}

model Device {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  unitId        String        @unique
  unit          InventoryUnit @relation(fields: [unitId], references: [id])
  warrantyUntil DateTime
  createdAt     DateTime      @default(now())
  repairs       Repair[]
  tradeIns      TradeIn[]
}

model TradeInRule {
  id             String  @id @default(cuid())
  model          String  @unique
  baseValue      Int
  goodPercent    Int     @default(85)
  fairPercent    Int     @default(65)
  damagedPercent Int     @default(30)
  active         Boolean @default(true)
}

model TradeIn {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  deviceId      String?
  device        Device?        @relation(fields: [deviceId], references: [id])
  kind          String         @default("TRADE_IN")
  model         String
  storage       String
  condition     String
  answers       Json
  estimate      Int
  finalValue    Int?
  status        String         @default("SUBMITTED")
  createdAt     DateTime       @default(now())
  order         Order?
  tradeInQuotes TradeInQuote[]

  @@index([userId, createdAt])
}

model Repair {
  partMovements        PartMovement[]
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id])
  deviceId             String?
  device               Device?               @relation(fields: [deviceId], references: [id])
  model                String
  issue                String
  description          String
  method               String
  appointment          DateTime?
  status               String                @default("REQUESTED")
  technician           String?
  assignedTechnicianId String?
  assignedTechnician   User?                 @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: Restrict)
  assignments          RepairAssignment[]
  createdAt            DateTime              @default(now())
  history              RepairStatusHistory[]
  quotes               RepairQuote[]
  part                 Part?                 @relation(fields: [partId], references: [id])
  partId               String?
  repairQCs            RepairQC[]
  repairWarranty       RepairWarranty?

  @@index([userId, createdAt])
}

model RepairAssignment {
  id           String   @id @default(cuid())
  repairId     String
  repair       Repair   @relation(fields: [repairId], references: [id], onDelete: Restrict)
  technicianId String
  technician   User     @relation("RepairTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  assignedById String?
  assignedBy   User?    @relation("RepairAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  reason       String
  createdAt    DateTime @default(now())

  @@index([repairId, createdAt])
}

model RepairStatusHistory {
  id        String   @id @default(cuid())
  repairId  String
  repair    Repair   @relation(fields: [repairId], references: [id])
  status    String
  note      String
  createdAt DateTime @default(now())
}

model RepairQuote {
  id           String    @id @default(cuid())
  repairId     String
  repair       Repair    @relation(fields: [repairId], references: [id])
  diagnosis    String
  parts        Int
  labor        Int
  total        Int
  warrantyDays Int
  status       String    @default("PENDING")
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
}

model SupportTicket {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  subject   String
  status    String          @default("OPEN")
  createdAt DateTime        @default(now())
  messages  TicketMessage[]
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  body      String
  internal  Boolean       @default(false)
  staff     Boolean       @default(false)
  createdAt DateTime      @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CMSPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  blocks      Json
  published   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  requestId String
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  payloadHash String
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
}

model Job {
  id        String   @id @default(cuid())
  type      String
  payload   Json
  key       String   @unique
  attempts  Int      @default(0)
  status    String   @default("PENDING")
  runAt     DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  entityId  String?
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model BookingAllocation {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  unitId    String        @unique
  unit      InventoryUnit @relation(fields: [unitId], references: [id])
  createdAt DateTime      @default(now())

  @@index([orderId])
}

model PolicyAcceptance {
  id             String   @id @default(cuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id])
  policySlug     String
  policyVersion  String
  policySnapshot Json
  acceptedAt     DateTime @default(now())
}

// ── SECTION 92: Universal Device Identity Graph ────────────────────
model DeviceIdentity {
  unitId             String?             @unique
  unit               InventoryUnit?      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  id                 String              @id @default(cuid())
  canonicalId        String              @unique @default(dbgenerated("'DEVICE-IB-' || nextval('device_identity_number_seq')::text"))
  productId          String?
  product            Product?            @relation(fields: [productId], references: [id])
  variantId          String?
  variant            ProductVariant?     @relation(fields: [variantId], references: [id])
  primaryImei        String?
  primarySerial      String?
  status             String              @default("IN_SUPPLY_CHAIN")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  links              IdentityLink[]
  events             DeviceEvent[]
  provenance         DeviceProvenance[]
  riskChecks         DeviceRiskCheck[]
  passports          DevicePassport[]
  refurbished        RefurbishedDevice?
  replacedBy         DeviceReplacement[] @relation("replacedBy")
  replaces           DeviceReplacement[] @relation("replaces")
  conditionEvidences ConditionEvidence[]
  conditionSnapshots ConditionSnapshot[]

  @@index([canonicalId])
  @@index([status])
}

model IdentityLink {
  id         String         @id @default(cuid())
  deviceId   String
  device     DeviceIdentity @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type       String
  valueHash  String
  valueLast4 String
  verified   Boolean        @default(false)
  verifiedAt DateTime?
  source     String?
  createdAt  DateTime       @default(now())

  @@unique([deviceId, type, valueHash])
  @@unique([type, valueHash])
  @@index([type, valueHash])
}

// ── SECTION 93: Device Event Ledger ────────────────────────────────
model DeviceEvent {
  eventKey        String?        @unique
  customerVisible Boolean        @default(false)
  id              String         @id @default(cuid())
  deviceId        String
  device          DeviceIdentity @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  eventType       String
  timestamp       DateTime       @default(now())
  actor           String
  location        String?
  reference       String?
  metadata        Json

  @@index([deviceId, timestamp])
  @@index([eventType])
}

// ── SECTION 94: Device Passport ────────────────────────────────────
model DevicePassport {
  id                String         @id @default(cuid())
  deviceId          String
  device            DeviceIdentity @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  generatedAt       DateTime       @default(now())
  version           Int            @default(1)
  productName       String?
  model             String?
  storage           String?
  color             String?
  purchaseDate      DateTime?
  seller            String?
  invoiceNo         String?
  warrantyUntil     DateTime?
  conditionGrade    String?
  repairHistory     Json?
  ownershipHistory  Json?
  tradeInEligible   Boolean?
  accessoriesCompat Json?
  permittedFields   String[]
}

// ── SECTION 96: Device Provenance ──────────────────────────────────
model DeviceProvenance {
  id                 String         @id @default(cuid())
  deviceId           String
  device             DeviceIdentity @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  supplier           String?
  purchaseOrder      String?
  invoiceRef         String?
  importSource       String?
  receivedDate       DateTime?
  warehouse          String?
  inspection         Json?
  ownershipFrom      String?
  ownershipDate      DateTime?
  repairIntervention Json?
  tradeInInspection  Json?
  refurbishment      Json?
  resaleDate         DateTime?
  inventoryClass     String         @default("NEW")
  createdAt          DateTime       @default(now())
}

// ── SECTION 97: Device Trust & Risk Check ─────────────────────────
model DeviceRiskCheck {
  id          String         @id @default(cuid())
  deviceId    String
  device      DeviceIdentity @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  checkType   String
  result      String
  details     Json?
  performedAt DateTime       @default(now())
  operator    String?
  expiresAt   DateTime?

  @@index([deviceId, performedAt])
}

// ── SECTION 98: Condition Evidence Engine ─────────────────────────
model ConditionEvidence {
  id           String         @id @default(cuid())
  deviceId     String
  device       DeviceIdentity @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  inspectionId String
  tradeInId    String?
  repairId     String?
  type         String
  fileName     String
  fileUrl      String
  category     String
  capturedAt   DateTime       @default(now())
  inspector    String?
  location     String?
  metadata     Json?
}

model ConditionSnapshot {
  id                  String         @id @default(cuid())
  deviceId            String
  device              DeviceIdentity @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  version             Int            @default(1)
  snapshotDate        DateTime       @default(now())
  condition           String
  batteryHealth       Float?
  screenCondition     String?
  bodyCondition       String?
  cameraCondition     String?
  biometrics          String?
  diagnosticResult    Json?
  technicianNotes     String?
  customerDeclaration Json?
  inspector           String?
  location            String?
}

// ── SECTION 99: Trade-in Quote Versioning ─────────────────────────
model TradeInQuote {
  id            String    @id @default(cuid())
  tradeInId     String
  tradeIn       TradeIn?  @relation(fields: [tradeInId], references: [id])
  version       String
  stage         String
  previousValue Int?
  newValue      Int
  difference    Int?
  reasonCodes   String[]
  evidenceIds   String[]
  approver      String?
  approvedAt    DateTime?
  status        String    @default("DRAFT")
  createdAt     DateTime  @default(now())

  @@unique([tradeInId, version])
}

// ── SECTION 102: Refurbished Device Engine ────────────────────────
model RefurbishedDevice {
  id               String         @id @default(cuid())
  deviceId         String         @unique
  device           DeviceIdentity @relation(fields: [deviceId], references: [id])
  grade            String
  conditionReport  Json
  batteryCondition String?
  screenCondition  String?
  bodyCondition    String?
  cameraCondition  String?
  biometrics       String?
  partsReplaced    String[]
  qcResult         String?
  technician       String?
  warrantyStart    DateTime?
  warrantyEnd      DateTime?
  sellingPrice     Int?
  status           String         @default("GRADING")
  createdAt        DateTime       @default(now())
}

// ── SECTION 105: Repair Parts System ──────────────────────────────
model Part {
  movements       PartMovement[]
  id              String              @id @default(cuid())
  sku             String              @unique
  name            String
  category        String?
  description     String?
  cost            Int?
  supplierId      String?
  supplier        PartSupplier?       @relation(fields: [supplierId], references: [id])
  stock           Int                 @default(0)
  binLocation     String?
  warranty        String?
  batchLot        String?
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  compatibilities PartCompatibility[]
  repairBOMs      RepairBOM[]
  repairJobs      Repair[]
  repairBOMItems  RepairBOMItem[]
}

model PartSupplier {
  id                 String              @id @default(cuid())
  name               String
  contact            String?
  email              String?
  phone              String?
  parts              Part[]
  rating             Float?
  active             Boolean             @default(true)
  purchaseOrders     PurchaseOrder[]
  supplierScorecards SupplierScorecard[]
}

model PartCompatibility {
  id       String  @id @default(cuid())
  partId   String
  part     Part    @relation(fields: [partId], references: [id], onDelete: Cascade)
  deviceId String
  device   Product @relation(fields: [deviceId], references: [id])

  @@unique([partId, deviceId])
}

// ── SECTION 106: Repair BOM ───────────────────────────────────────
model RepairBOM {
  id                 String          @id @default(cuid())
  code               String          @unique
  name               String
  description        String?
  category           String?
  parts              RepairBOMItem[]
  laborMinutes       Int             @default(0)
  diagnosticRequired Boolean         @default(false)
  qcChecklist        String[]
  active             Boolean         @default(true)
  createdAt          DateTime        @default(now())
  part               Part?           @relation(fields: [partId], references: [id])
  partId             String?
}

model RepairBOMItem {
  id       String    @id @default(cuid())
  bomId    String
  bom      RepairBOM @relation(fields: [bomId], references: [id], onDelete: Cascade)
  partId   String
  part     Part      @relation(fields: [partId], references: [id])
  quantity Int       @default(1)
  unit     String    @default("unit")
}

